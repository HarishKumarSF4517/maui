<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Maui.Controls.Sample"
             x:Class="Maui.Controls.Sample.DatePickerMainControlPage"
             x:DataType="local:DatePickerViewModel"
             Title="DatePickerControlPage">
       <ContentPage.ToolbarItems>
              <ToolbarItem Text="Options"
                           Clicked="NavigateToOptionsPage_Clicked"
                           AutomationId="Options"/>
       </ContentPage.ToolbarItems>
       <VerticalStackLayout
              Spacing="20">
              <VerticalStackLayout x:Name="DatePickerLayout"
                                   Padding="20,100,20,100">
                     <DatePicker x:Name="DatePickerControl"
                                 AutomationId="DatePickerControl"
                                 Background="{Binding Background}"
                                 CharacterSpacing="{Binding CharacterSpacing}"
                                 Closed="OnClosed"
                                 Date="{Binding Date}"
                                 DateSelected="OnDateSelected"
                                 FlowDirection="{Binding FlowDirection}"
                                 Format="{Binding Format}"
                                 FontAttributes="{Binding FontAttributes}"
                                 FontAutoScalingEnabled="{Binding FontAutoScalingEnabled}"
                                 FontFamily="{Binding FontFamily}"
                                 FontSize="{Binding FontSize}"
                                 IsEnabled="{Binding IsEnabled}"
                                 IsOpen="{Binding IsOpen, Mode=TwoWay}"
                                 IsVisible="{Binding IsVisible}"
                                 MinimumDate="{Binding MinimumDate}"
                                 MaximumDate="{Binding MaximumDate}"
                                 Opened="OnOpened"
                                 Shadow="{Binding Shadow}"
                                 TextColor="{Binding TextColor}"/>
              </VerticalStackLayout>

              <HorizontalStackLayout HorizontalOptions="Center"
                                     Spacing="8">
                     <Button AutomationId="OpenDatePickerButton"
                             Clicked="OpenDatePickerButton_Clicked"
                             Text="Open"/>
                     <Button AutomationId="CloseDatePickerButton"
                             Clicked="CloseDatePickerButton_Clicked"
                             Text="Close"/>
                     <Button AutomationId="FocusDatePickerButton"
                             Clicked="FocusDatePickerButton_Clicked"
                             Text="Focus"/>
                     <Button AutomationId="UnfocusDatePickerButton"
                             Clicked="UnfocusDatePickerButton_Clicked"
                             Text="Unfocus"/>
              </HorizontalStackLayout>

              <Label Text="DateSelected Event"
                     HorizontalOptions="Center"/>
              <HorizontalStackLayout HorizontalOptions="Center">
                     <Label Text="New Date: "/>
                     <Label x:Name="NewDateSelectedLabel"
                            AutomationId="NewDateSelectedLabel"/>
              </HorizontalStackLayout>
              <HorizontalStackLayout HorizontalOptions="Center">
                     <Label Text="Old Date: "/>
                     <Label x:Name="OldDateSelectedLabel"
                            AutomationId="OldDateSelectedLabel"/>
              </HorizontalStackLayout>

              <Label Text="Opened/Closed Event"
                     FontAttributes="Bold"
                     HorizontalOptions="Center"/>
              <HorizontalStackLayout HorizontalOptions="Center">
                     <Label Text="Dropdown State: "/>
                     <Label x:Name="DropdownStateLabel"
                            AutomationId="DropdownStateLabel"/>
              </HorizontalStackLayout>
              <HorizontalStackLayout HorizontalOptions="Center"
                                     Spacing="12">
                     <Label AutomationId="IsOpenStatusLabel"
                            Text="{Binding IsOpen, StringFormat='IsOpen: {0}'}"/>
                     <Label x:Name="OpenedCountLabel"
                            AutomationId="OpenedCountLabel"
                            Text="Opened: 0"/>
                     <Label x:Name="ClosedCountLabel"
                            AutomationId="ClosedCountLabel"
                            Text="Closed: 0"/>
              </HorizontalStackLayout>

              <Label Text="Culture Format Display"
                     HorizontalOptions="Center"
                     FontAttributes="Bold"
                     Margin="0,10,0,0"/>
              <Label x:Name="CultureFormatLabel"
                     HorizontalOptions="Center"
                     AutomationId="CultureFormatLabel"
                     Margin="0,0,0,10"/>
       </VerticalStackLayout>
</ContentPage>
